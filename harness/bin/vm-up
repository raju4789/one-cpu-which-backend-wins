#!/usr/bin/env bash
# Starts both VMs and the monitoring stack.
source "$(dirname "$0")/common.sh"

docker compose version >/dev/null 2>&1 || fail "docker compose not found. See 'One-time setup' in harness/README.md"

# Starts a VM with its own IP address. A VM created without one is restarted with it.
start_vm() {
  local profile="$1"; shift
  colima start --profile "$profile" "$@" --vm-type vz --arch aarch64 --mount-type virtiofs --network-address
  if [ -z "$(colima_ip "$profile")" ]; then
    log "Restarting $profile to give it its own IP address"
    colima stop --profile "$profile"
    colima start --profile "$profile" "$@" --vm-type vz --arch aarch64 --mount-type virtiofs --network-address
  fi
  [ -n "$(colima_ip "$profile")" ] || fail "$profile has no IP address; check 'colima list'"
}

log "Starting bench VM: 1 vCPU, 2 GB (the \$12 box)"
start_vm "$BENCH_PROFILE" --cpu 1 --memory 2 --disk 30

# Docker 29 defaults to the containerd image store, and cAdvisor can't see
# containers in it, so per-container CPU and memory go missing. Switch the
# bench VM to the classic overlay2 store (the default for years before 29).
cfg="${COLIMA_HOME:-$HOME/.colima}/$BENCH_PROFILE/colima.yaml"
if ! grep -q 'containerd-snapshotter: false' "$cfg"; then
  grep -q '^docker: {}' "$cfg" || fail "custom 'docker:' section in $cfg; add 'features: {containerd-snapshotter: false}' to it by hand"
  log "Switching the bench VM's Docker to the overlay2 image store (needed by cAdvisor)"
  colima stop --profile "$BENCH_PROFILE"
  perl -0pi -e 's/^docker: \{\}/docker:\n  features:\n    containerd-snapshotter: false/m' "$cfg"
  colima start --profile "$BENCH_PROFILE"
fi

log "Starting monitor VM: 2 vCPU, 2 GB"
start_vm "$MONITOR_PROFILE" --cpu 2 --memory 2 --disk 20

bench_ip="$(colima_ip "$BENCH_PROFILE")"
monitor_ip="$(colima_ip "$MONITOR_PROFILE")"

# Prometheus finds the bench VM's exporters through these files (file_sd).
targets="$HARNESS_DIR/monitoring/targets"
mkdir -p "$targets"
for t in cadvisor:8081 postgres:9187 nginx:9113; do
  printf '[{"targets": ["%s:%s"]}]\n' "$bench_ip" "${t#*:}" > "$targets/${t%%:*}.json"
done

log "Starting Prometheus and Grafana"
monitor compose -f "$HARNESS_DIR/monitoring/compose.yaml" up -d

log "Bench VM: $bench_ip   Load goes to http://$bench_ip:8080"
log "Grafana: http://localhost:3000   Prometheus: http://$monitor_ip:9090"
