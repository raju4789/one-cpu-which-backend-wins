#!/usr/bin/env bash
# Fixed CPU workload inside the bench VM: hashes 2 GB of zeros, 3 times.
# Prints the median in seconds. Lower is faster.
# With BASELINE=<seconds>, exits 1 if the result is more than 5% off it,
# which means the laptop is noisier than usual and the run should be discarded.
source "$(dirname "$0")/common.sh"

one_run() {
  bench run --rm alpine:3.20 sh -c '
    a=$(cut -d" " -f1 /proc/uptime)
    dd if=/dev/zero bs=1M count=2048 2>/dev/null | sha256sum >/dev/null
    b=$(cut -d" " -f1 /proc/uptime)
    awk -v a="$a" -v b="$b" "BEGIN { printf \"%.2f\n\", b - a }"'
}

results="$(for _ in 1 2 3; do one_run; done | sort -n)"
median="$(echo "$results" | sed -n 2p)"
echo "calibration_seconds=$median   (runs: $(echo $results))"

if [ -n "${BASELINE:-}" ]; then
  awk -v m="$median" -v b="$BASELINE" 'BEGIN {
    d = (m - b) / b * 100; if (d < 0) d = -d
    printf "deviation from baseline: %.1f%%\n", d
    exit (d > 5) ? 1 : 0 }' || fail "more than 5% off baseline: discard this run"
fi
