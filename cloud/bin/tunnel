#!/usr/bin/env bash
# Grafana and Prometheus on loadgen, reachable from the Mac while this runs:
# http://localhost:3000 (Grafana), http://localhost:9090 (Prometheus). Ctrl-C ends it.
source "$(dirname "$0")/common.sh"
log "Grafana: http://localhost:3000   Prometheus: http://localhost:9090   (Ctrl-C to close)"
ssh -N "${SSH_OPTS[@]}" -L 3000:127.0.0.1:3000 -L 9090:127.0.0.1:9090 "root@$(loadgen_ip)"
